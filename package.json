{
  "name": "scenephonie",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @scenephonie/web dev",
    "build": "pnpm --filter @scenephonie/web build",
    "start": "pnpm --filter @scenephonie/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "db:generate": "pnpm --filter @scenephonie/web db:generate",
    "db:migrate": "pnpm --filter @scenephonie/web db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
