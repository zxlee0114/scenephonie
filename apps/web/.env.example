# 連線模型的完整說明見 docs/tech-stack.md「連線模型」。
# 兩條連線字串都從 Supabase 專案 dashboard（Project Settings → Database）複製，
# 主機名與 project-ref 依專案而定。

# 執行期查詢 —— Supavisor transaction mode（port 6543）。程式碼已設 prepare:false。
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres"

# migration 專用 —— session mode（session pooler，port 5432）。drizzle-kit 用這條。
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ── 本機開發 ─────────────────────────────────────────────────────────────
# 首選 `supabase start`（若已安裝 Supabase CLI），否則 `docker compose up -d db`。
# 兩條都指向本機 Postgres 即可：
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scenephonie"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scenephonie"

# ── 認證（票券 06）─────────────────────────────────────────────────────────
# Better Auth ~1.7.x。DB session 存上面那顆 Postgres，沒有第二套儲存。

# 這個部署對外的網址。production 務必設，否則 Google 的 redirect URI 會對不上。
BETTER_AUTH_URL="http://localhost:3000"
# session cookie 與 cookie cache 的簽章金鑰。`openssl rand -base64 32` 產生，勿共用。
BETTER_AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID（Web application）。
# Authorized redirect URI 填 <BETTER_AUTH_URL>/api/auth/callback/google。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 誰能登入 —— Google OAuth 的 registration/access policy（票券 24 §7）。
# 逗號分隔的 email 清單。**不是 `invitations` 表**：v1 不公開註冊，使用者就是作者本人與
# 明確邀請的編劇朋友，env var 一看就知道是暫時物，不會假裝自己是領域模型。
# ⚠️ 沒設或設空＝誰都不准進（fail closed）。
AUTH_ALLOWED_EMAILS=""
